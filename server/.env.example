# Copy this file to .env and fill in your real credentials to go LIVE.
# The server reads process environment variables — set them however you run Node.

# --- Server ---
PORT=3000

# --- SMS (MSG91) — enables real OTP via SMS. Leave empty for demo mode. ---
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=BKCAFE

# --- Online payments ---
# Option A: Razorpay (cards + UPI + netbanking). Leave empty to fall back to UPI deep-link.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Option B: UPI fallback — the cafe's UPI ID (used when Razorpay is not configured).
UPI_ID=7972385812@upi
UPI_NAME=Bakers Gallery

# --- WhatsApp auto-notification (Meta WhatsApp Cloud API) ---
# The backend sends each new order to the owner's WhatsApp automatically.
# Get these from developers.facebook.com (WhatsApp > API Setup). Free tier is fine.
WHATSAPP_TOKEN=            # permanent access token
WHATSAPP_PHONE_ID=         # the sender's phone-number ID
WHATSAPP_OWNER=917972385812  # the owner's number that RECEIVES orders (digits only, intl format)
WHATSAPP_TEMPLATE=         # optional: approved template name; omit to use a plain text message
